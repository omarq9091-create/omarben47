# BEN Froid Adrar environment template
# Copy this file to .env and replace placeholders with real values
# Never commit .env or .env.local files to Git

APP_URL=http://localhost:5173
NODE_ENV=development
PORT=3000

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase client settings for Vite frontend
# Note: This project uses VITE_ variables, not NEXT_PUBLIC_ variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase server-side secret settings
# Keep these only on the server side and never expose them to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin auth
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_USERNAMES=admin,superadmin,benfroid

# Optional local data fallback path
DB_FILE_PATH=./data/store_db.json
